# Copy to infra/.env and fill in. Never commit infra/.env (see .gitignore).
# All app env vars are prefixed YOHAN_ (pydantic-settings env_prefix).

# --- Bus / DB (consumed by yohan_core.CoreSettings) ---
YOHAN_REDIS_URL=redis://localhost:6379/0
YOHAN_POSTGRES_DSN=postgresql://yohan:yohan@localhost:5432/yohan

# --- Postgres container (consumed by docker-compose) ---
POSTGRES_USER=yohan
POSTGRES_PASSWORD=yohan
POSTGRES_DB=yohan

# --- Telegram (consumed by yohan_gateway.GatewaySettings) ---
# From @BotFather:
YOHAN_TELEGRAM_BOT_TOKEN=
# A random string you invent; set the same value when registering the webhook.
# Telegram echoes it back on every call so only it can reach the gateway.
YOHAN_TELEGRAM_WEBHOOK_SECRET=
# Comma-separated chat ids allowed to command the bot. Get yours by messaging
# the bot once and reading the chat.id in the gateway logs. Leave empty in early
# dev to allow all — but SET IT before the Cloudflare tunnel is public.
YOHAN_TELEGRAM_ALLOWED_CHAT_IDS=

# --- Cloudflare Tunnel (used by scripts/set_webhook.sh, not by app code) ---
# The public HTTPS URL your tunnel maps to localhost:8000, e.g.
# https://agent.yourdomain.com
YOHAN_PUBLIC_URL=
